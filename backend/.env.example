# Database (defaults to SQLite for local dev)
DATABASE_URL=sqlite:///./paper_generator.db

# Supabase (optional — auth stubs work without these)
SUPABASE_URL=
SUPABASE_KEY=

# LLM provider: local | claude | byok | mock
#   local  — Ollama or any OpenAI-compatible server at OLLAMA_BASE_URL (no key needed)
#   byok   — key + base URL from the app Settings panel (OpenRouter, OpenAI, etc.)
#   claude — server-side Anthropic key (ANTHROPIC_API_KEY)
#   mock   — fixture data only
LLM_PROVIDER=local
USE_MOCK_LLM=false

# API keys (server-side, not used in BYOK mode)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Model + endpoint (used for local and BYOK modes)
# Local Ollama example:
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=minimax-m3:cloud
# OpenRouter BYOK example (set LLM_PROVIDER=byok, add key in app Settings):
# OLLAMA_MODEL=openai/gpt-4o-mini
# LM Studio example (set LLM_PROVIDER=local):
# OLLAMA_BASE_URL=http://localhost:1234/v1
# OLLAMA_MODEL=your-loaded-model
EMBEDDING_MODEL=nomic-embed-text

# Auth
JWT_SECRET=dev-secret-change-in-production

# Storage paths
UPLOAD_DIR=./uploads
EXPORT_DIR=./exports
